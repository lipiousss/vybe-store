POSTGRES_DB=vybe_store
POSTGRES_USER=vybe
POSTGRES_PASSWORD=change_this_database_password

JWT_SECRET=change_this_to_a_long_random_secret

# Use the public site address here.
# For a VPS without domain, use http://YOUR_SERVER_IP
# For a domain with HTTPS, use https://your-domain.ru
CLIENT_URL=http://YOUR_SERVER_IP

# Frontend talks to backend through the same Nginx host.
VITE_API_URL=/api

HTTP_PORT=80

RUN_SEED_ON_START=false
RUN_SEED_FORCE=false
SEED_FORCE=false

# Optional pgAdmin profile:
PGADMIN_DEFAULT_EMAIL=admin@vybe.com
PGADMIN_DEFAULT_PASSWORD=change_this_pgadmin_password
PGADMIN_PORT=5050
