POSTGRES_DB=vybe_store
POSTGRES_USER=vybe
POSTGRES_PASSWORD=change_this_to_a_long_database_password

JWT_SECRET=change_this_to_a_long_random_jwt_secret

# VPS public address. For the current demo server:
# CLIENT_URL=http://194.87.187.168
# If you connect a domain later, use https://your-domain.ru
CLIENT_URL=http://194.87.187.168
FRONTEND_URL=http://194.87.187.168

# Frontend talks to backend through the same Nginx host.
VITE_API_URL=/api

HTTP_PORT=80

# Optional HTTPS/domain mode with docker-compose.caddy.yml:
# 1. Point an A record to this VPS IP.
# 2. Set SITE_DOMAIN to the domain without protocol.
# 3. Set HTTP_PORT=127.0.0.1:8080 so only Caddy listens publicly on 80/443.
# 4. Start with:
#    docker compose --env-file .env.production -f docker-compose.production.yml -f docker-compose.caddy.yml up -d --build
SITE_DOMAIN=vybe-store.example.ru
SITE_EMAIL=admin@vybe.com

# Safe on first deploy: seed runs only if the database has zero products.
RUN_SEED_ON_START=true
RUN_SEED_FORCE=false
SEED_FORCE=false

# Optional pgAdmin profile:
PGADMIN_DEFAULT_EMAIL=admin@vybe.com
PGADMIN_DEFAULT_PASSWORD=change_this_pgadmin_password
PGADMIN_PORT=5050
